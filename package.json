{
  "name": "@itslorant/mnb-exchange-rates",
  "version": "0.1.0",
  "description": "Typed client for the Hungarian National Bank (MNB) exchange rate SOAP API",
  "license": "MIT",
  "author": "itslorant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itslorant/mnb-exchange-rates.git"
  },
  "homepage": "https://github.com/itslorant/mnb-exchange-rates#readme",
  "bugs": {
    "url": "https://github.com/itslorant/mnb-exchange-rates/issues"
  },
  "keywords": [
    "mnb",
    "magyar nemzeti bank",
    "hungarian national bank",
    "exchange rates",
    "huf",
    "soap"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "MNB_LIVE=1 vitest run test/live.test.ts",
    "prepare": "husky",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "publishConfig": {
    "access": "public"
  }
}
